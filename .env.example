# MCP and skill-related environment variables
#
# Copy to .env for local overrides (gitignored).
#
# AGENT_BOOTSTRAP_HOME is NOT configured here. It is derived from wherever
# you clone this repo. install.sh exports it from the repo root; add the same
# path to your shell profile if you want it in every session, e.g.:
#   export AGENT_BOOTSTRAP_HOME="$HOME/Dev/agent_bootstrap"

# --- Grafana Assistant (grafana-assistant package / skill) ---
GRAFANA_URL=https://mystack.grafana.net
GRAFANA_SA_TOKEN=glsa_xxxx
# Optional: override config file path
# GRAFANA_ASSISTANT_CONFIG=~/.config/grafana-assistant/config.yaml

# --- JFrog MCP (only added to mcp.json when this is set) ---
JFROG_PLATFORM_URL=myteam.jfrog.io

# --- Continual Learning hook thresholds (optional) ---
CONTINUAL_LEARNING_MIN_TURNS=10
CONTINUAL_LEARNING_MIN_MINUTES=120

# --- AWS MCP servers (awsiac, awspricing via uvx) ---
# Uses standard AWS credential chain — profile, env vars, or instance role.
# AWS_PROFILE=default
# AWS_REGION=us-east-1

# --- Notes ---
# GitLab, Notion, and Context7 in mcp/mcp.json typically use OAuth in the IDE
# (mcp_auth browser flow) — no env vars required for gitlab.com defaults.
