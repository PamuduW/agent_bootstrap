#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${AGENTBOT_HOME:-}" && -d "$AGENTBOT_HOME" ]]; then
  AGENTBOT_HOME="$(cd "$AGENTBOT_HOME" && pwd)"
else
  # Resolve the executable first: install.sh exposes Agentbot through
  # ~/bin/agentbot, and BASH_SOURCE would otherwise resolve that symlink's
  # directory instead of this repository.
  AGENTBOT_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
  AGENTBOT_HOME="$(cd "$(dirname "$AGENTBOT_SCRIPT")/.." && pwd)"
fi
export AGENTBOT_HOME

# shellcheck source=/dev/null
source "$AGENTBOT_HOME/scripts/lib/command_catalog.sh"
# shellcheck source=/dev/null
source "$AGENTBOT_HOME/scripts/lib/command_help.sh"

agentbot_die() { printf '[err] %s\n' "$*" >&2; return 1; }
agentbot_info() { printf '[info] %s\n' "$*"; }

agentbot_has_tty() {
  case "${AGENTBOT_TTY:-}" in 1|true) return 0 ;; 0|false) return 1 ;; esac
  local tty_fd
  exec {tty_fd}<>/dev/tty 2>/dev/null || return 1
  [[ -t "$tty_fd" ]]
}

agentbot_run_menu() {
  if [[ "${AGENTBOT_MENU_LOADED:-0}" != 1 ]]; then
    # shellcheck source=/dev/null
    source "$AGENTBOT_HOME/scripts/menu.sh"
    AGENTBOT_MENU_LOADED=1
  fi
  agentbot_menu_loop
}
agentbot_run_token() { agentbot_die 'Agentbot token screen is not available until the TUI slice.'; }
agentbot_run_dotfiles() { agentbot_die 'Dotfiles integration is not available until the sibling integration slice.'; }
agentbot_run_backend() { "$AGENTBOT_HOME/install.sh" "$@"; }

AGENTBOT_BOOT_OPTIONAL_FLAGS=(--claude --copilot --cursor)
AGENTBOT_BOOT_DEFAULTS=(true false true)

agentbot_boot() {
  local target='' profile='' selectors_seen=false arg i flag
  local -a selected=()
  for i in "${!AGENTBOT_BOOT_OPTIONAL_FLAGS[@]}"; do selected+=("${AGENTBOT_BOOT_DEFAULTS[$i]}"); done

  while (($#)); do
    arg="$1"; shift
    case "$arg" in
      --profile)
        [[ $# -gt 0 ]] || { agentbot_die '--profile requires a name'; return 1; }
        profile="$1"
        shift
        ;;
      --agents|--codex|--claude|--copilot|--cursor)
        if [[ "$selectors_seen" == false ]]; then
          for i in "${!selected[@]}"; do selected[i]=false; done
          selectors_seen=true
        fi
        if [[ "$arg" != --agents && "$arg" != --codex ]]; then
          for i in "${!AGENTBOT_BOOT_OPTIONAL_FLAGS[@]}"; do
            flag="${AGENTBOT_BOOT_OPTIONAL_FLAGS[$i]}"
            if [[ "$arg" == "$flag" ]]; then
              selected[i]=true
              break
            fi
          done
        fi
        ;;
      --*)
        agentbot_die "unknown boot selector: $arg"
        return 1
        ;;
      *)
        [[ -z "$target" ]] || { agentbot_die 'boot accepts only one TARGET directory'; return 1; }
        target="$arg"
        ;;
    esac
  done
  target="${target:-$PWD}"
  [[ -d "$target" && -w "$target" ]] || { agentbot_die "boot target must be a writable directory: $target"; return 1; }

  local targets_csv=agents
  for i in "${!selected[@]}"; do
    [[ "${selected[$i]}" == true ]] || continue
    targets_csv+=",${AGENTBOT_BOOT_OPTIONAL_FLAGS[$i]#--}"
  done

  local -a backend_args=(workspace --yes)
  [[ -n "$profile" ]] && backend_args+=(--profile "$profile")
  backend_args+=(--targets "$targets_csv" "$target")
  agentbot_run_backend "${backend_args[@]}"
}

agentbot_usage() {
	agentbot_command_help_render_plain "${COLUMNS:-100}"
}

agentbot_main() {
  local command="${1:-}"
  [[ $# -eq 0 ]] || shift
  case "$command" in
    '')
      if agentbot_has_tty; then agentbot_run_menu
      else agentbot_die 'No usable controlling TTY. Use agentbot help or an explicit command such as agentbot install.'; fi
      ;;
    status|install|doctor) agentbot_run_backend "$command" "$@" ;;
    boot) agentbot_boot "$@" ;;
    workspace|workspaces|resync) agentbot_run_backend "$command" "$@" ;;
    token) agentbot_run_token "$@" ;;
    dotfiles) agentbot_run_dotfiles "$@" ;;
    update|upgrade) agentbot_run_backend "$command" "$@" ;;
    help|-h|--help) agentbot_usage ;;
    *) agentbot_die "unknown command: $command (run agentbot help)" ;;
  esac
}

if [[ "${AGENTBOT_SOURCE_ONLY:-0}" != 1 ]]; then
  agentbot_main "$@"
fi
