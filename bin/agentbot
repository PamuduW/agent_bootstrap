#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${AGENTBOT_HOME:-}" && -d "$AGENTBOT_HOME" ]]; then
  AGENTBOT_HOME="$(cd "$AGENTBOT_HOME" && pwd)"
else
  AGENTBOT_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi
export AGENTBOT_HOME

agentbot_die() { printf '[err] %s\n' "$*" >&2; return 1; }
agentbot_info() { printf '[info] %s\n' "$*"; }

agentbot_has_tty() {
  case "${AGENTBOT_TTY:-}" in 1|true) return 0 ;; 0|false) return 1 ;; esac
  local tty_fd
  exec {tty_fd}<>/dev/tty 2>/dev/null || return 1
  [[ -t "$tty_fd" ]]
}

agentbot_run_menu() {
  if [[ "${AGENTBOT_MENU_LOADED:-0}" != 1 ]]; then
    # shellcheck source=/dev/null
    source "$AGENTBOT_HOME/scripts/menu.sh"
    AGENTBOT_MENU_LOADED=1
  fi
  agentbot_menu_loop
}
agentbot_run_token() { agentbot_die 'Agentbot token screen is not available until the TUI slice.'; }
agentbot_run_dotfiles() { agentbot_die 'Dotfiles integration is not available until the sibling integration slice.'; }
agentbot_run_backend() { "$AGENTBOT_HOME/install.sh" "$@"; }

AGENTBOT_BOOT_FLAGS=(--agents --claude)
AGENTBOT_BOOT_SOURCES=(base/AGENTS.md base/CLAUDE.md)
AGENTBOT_BOOT_DESTINATIONS=(AGENTS.md CLAUDE.md)
AGENTBOT_BOOT_DEFAULTS=(true true)

agentbot_boot() {
  local force=false target='' selectors_seen=false arg i flag
  local -a selected=()
  for i in "${!AGENTBOT_BOOT_FLAGS[@]}"; do selected+=("${AGENTBOT_BOOT_DEFAULTS[$i]}"); done

  while (($#)); do
    arg="$1"; shift
    case "$arg" in
      --force) force=true ;;
      --*)
        if [[ "$selectors_seen" == false ]]; then
          for i in "${!selected[@]}"; do selected[i]=false; done
          selectors_seen=true
        fi
        local matched=false
        for i in "${!AGENTBOT_BOOT_FLAGS[@]}"; do
          flag="${AGENTBOT_BOOT_FLAGS[$i]}"
          if [[ "$arg" == "$flag" ]]; then selected[i]=true; matched=true; break; fi
        done
        [[ "$matched" == true ]] || { agentbot_die "unknown boot selector: $arg"; return 1; }
        ;;
      *)
        [[ -z "$target" ]] || { agentbot_die 'boot accepts only one TARGET directory'; return 1; }
        target="$arg"
        ;;
    esac
  done
  target="${target:-$PWD}"
  [[ -d "$target" && -w "$target" ]] || { agentbot_die "boot target must be a writable directory: $target"; return 1; }

  local selected_count=0 src dest
  for i in "${!selected[@]}"; do
    [[ "${selected[$i]}" == true ]] || continue
    selected_count=$((selected_count + 1))
    src="$AGENTBOT_HOME/${AGENTBOT_BOOT_SOURCES[$i]}"
    [[ -f "$src" ]] || { agentbot_die "missing template: $src"; return 1; }
  done
  ((selected_count > 0)) || { agentbot_die 'select at least one boot output'; return 1; }

  for i in "${!selected[@]}"; do
    [[ "${selected[$i]}" == true ]] || continue
    src="$AGENTBOT_HOME/${AGENTBOT_BOOT_SOURCES[$i]}"
    dest="$target/${AGENTBOT_BOOT_DESTINATIONS[$i]}"
    if [[ -e "$dest" && "$force" != true ]]; then
      agentbot_info "skip (exists): $dest"
    else
      cp -- "$src" "$dest"
      agentbot_info "wrote: $dest"
    fi
  done
}

agentbot_usage() {
  cat <<'EOF'
Usage: agentbot <command> [options]

Commands:
  status                         Show Agentbot status
  install                        Run the explicit Agentbot install
  token                          Open token configuration (future seam)
  boot [--agents] [--claude] [--force] [TARGET]
                                 Scaffold AGENTS.md and/or CLAUDE.md
  doctor                         Run Agentbot doctor
  update [--dry-run] [--yes]     Repo-first skill reconciliation update
  dotfiles                       Open Dotfiles integration (future seam)
  help                           Show this help

Scaffold the default pair with: agentbot boot [TARGET]
EOF
}

agentbot_main() {
  local command="${1:-}"
  [[ $# -eq 0 ]] || shift
  case "$command" in
    '')
      if agentbot_has_tty; then agentbot_run_menu
      else agentbot_die 'No usable controlling TTY. Use agentbot help or an explicit command such as agentbot install.'; fi
      ;;
    status|install|doctor) agentbot_run_backend "$command" "$@" ;;
    boot) agentbot_boot "$@" ;;
    token) agentbot_run_token "$@" ;;
    dotfiles) agentbot_run_dotfiles "$@" ;;
    update) agentbot_run_backend update "$@" ;;
    help|-h|--help) agentbot_usage ;;
    *) agentbot_die "unknown command: $command (run agentbot help)" ;;
  esac
}

if [[ "${AGENTBOT_SOURCE_ONLY:-0}" != 1 ]]; then
  agentbot_main "$@"
fi
